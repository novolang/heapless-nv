// tests/embedded_probe.nv — the package's device claim, as a program
// that either builds for a Cortex-M or does not.
//
// The shard audit's `core-embedded` row copies this and the modules its
// `use` lines reach into a package of its own and runs
//
//   novo build --target=nrf52-qemu src/probe.nv
//
// which produces a real Cortex-M4 ELF or fails.  For this package the
// claim IS the package: fixed-capacity collections are what a program
// with no allocator uses instead of the ones it cannot have, so one
// that did not compile without an allocator would be pointless.
//
// It BUILDS; it does not run.  Every function it calls is a `todo()`
// today, so a device that executed this would panic on the first line
// of `main`.  What is being checked is the tier: `--target=nrf52-qemu`
// stamps `@tier(embedded)` on every function it compiles, so the
// checker walks the module and refuses a list literal, a `Str`
// concatenation, a `Bytes` call or an unbounded `while` wherever the
// implementation later puts one.
//
// ALL FOUR COLLECTIONS ARE HERE, and the whole module is compiled —
// nothing in it touches `Bytes`, `Str` or `Result`, so there is no
// host-only half to leave out.

use heapless

// The storage the collections hand out indices into, the way firmware
// would hold it: a fixed inline array inside a `@value` struct, on the
// stack with no header and no allocation.  `[u8; 16]` is a true inline
// array only inside a `@value` struct — outside one, the annotation
// still means a list, and a list literal is a heap allocation the tier
// refuses (SPEC § 14.4).
@value
struct ProbeStore
    b: [u8; 16]

fn empty_store() -> ProbeStore
    ProbeStore { b: [0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8,
                     0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8, 0 as u8] }

fn main() [hw]
    // Each step is bound with its type written out because a call into
    // another module does not have its return type inferred in a
    // single-file build.  Inside a package built as one unit — which is
    // what every host suite does — none of these annotations is needed.
    let slots = empty_store()

    // The vector: ask for a slot, read the storage there, record the
    // write.  The read is what forces the index arithmetic to be
    // compiled rather than folded away.
    var v: BoundedVec = heapless.vec(16)
    for i in 0..4
        match heapless.vec_push_at(v)
            None     => hal.uart.write("heapless-nv: vector full\n")
            Some(at) =>
                let b: u8 = slots.b[at]
                v = heapless.vec_pushed(v)

    // The UTF-8 buffer, whose whole content is the all-or-nothing rule.
    var s: BoundedStr = heapless.bounded_str(16)
    let width: Int = heapless.str_seq_len(0xE2 as u8)
    match heapless.str_push_at(s, 0xE2 as u8)
        None     => hal.uart.write("heapless-nv: no room for a character\n")
        Some(at) =>
            s = heapless.str_pushed(s, 0xE2 as u8)

    // The FIFO, whose wrap is the arithmetic worth compiling for a
    // device because it is the part with a branch in it.
    var f: BoundedFifo = heapless.fifo(8)
    for i in 0..3
        match heapless.fifo_enqueue_at(f)
            None     => hal.uart.write("heapless-nv: queue full\n")
            Some(at) =>
                let b: u8 = slots.b[at]
                f = heapless.fifo_enqueued(f)
    match heapless.fifo_dequeue_at(f)
        None     => hal.uart.write("heapless-nv: queue empty\n")
        Some(at) =>
            f = heapless.fifo_dequeued(f)

    // The map, driven the way a caller drives it: a probe walk with the
    // comparison in the caller's hands.
    var m: BoundedMap = heapless.map(heapless.map_capacity_for(3))
    let probes: Int = heapless.map_max_probes(m)
    for p in 0..8
        let slot: Int = heapless.map_slot(m, 5, p)
        let b: u8 = slots.b[slot]
    m = heapless.map_inserted(m)
    if heapless.map_needs_rehash(m)
        m = heapless.map_cleared(m)

    hal.uart.write("heapless-nv: four collections, no allocator\n")
